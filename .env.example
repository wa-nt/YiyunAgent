# 第二大脑 Agent 配置样例：复制为 .env 后按需修改，未设置的项使用代码内默认值。

# LLM 后端：openai_compat（OpenAI / DeepSeek / 通义 / Moonshot 等兼容端点）或 anthropic
LLM_PROVIDER=openai_compat

# OpenAI 兼容后端
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic 后端（llm_provider=anthropic 时生效）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

# 向量化后端（与 LLM 独立，可指向本地或第三方 embedding 服务）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 向量维度，必须与 embed_model 的实际输出一致：决定 vec0 虚拟表 chunk_vectors 的列宽
EMBED_DIM=1024

# 存储：SQLite 文件路径（默认开发路径；可选生产路径见 docker-compose.yml 的 postgres+pgvector）
DB_PATH=data/app.db

# 切分：单块目标 token 数与相邻块重叠 token 数
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 分层记忆（Memory Governor）。MEMORY_ENABLED 是总开关，T10 的消融实验用它关掉记忆
MEMORY_ENABLED=true
# 召回条数：每轮注入 system 消息的长期记忆条数
MEMORY_RECALL_TOP_K=5
# 去重阈值：归一化（去称呼前缀/标点/空白）后整句的序列相似度，0.92 为保守值。
# brief 里写的 0.85 是 embedding cosine 刻度，与本实现度量的不是同一个量，故改名区分
MEMORY_DEDUP_RATIO=0.92
# 冲突时旧记忆的置信度衰减系数
MEMORY_DECAY=0.9