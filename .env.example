# 第二大脑 Agent 配置样例：复制为 .env 后按需修改，未设置的项使用代码内默认值。

# LLM 后端：openai_compat（OpenAI / DeepSeek / 通义 / Moonshot 等兼容端点）或 anthropic
LLM_PROVIDER=openai_compat

# OpenAI 兼容后端
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic 后端（llm_provider=anthropic 时生效）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

# 向量化后端（与 LLM 独立，可指向本地或第三方 embedding 服务）
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 向量维度，必须与 embed_model 的实际输出一致：决定 vec0 虚拟表 chunk_vectors 的列宽
EMBED_DIM=1024

# 存储：SQLite 文件路径（默认开发路径；可选生产路径见 docker-compose.yml 的 postgres+pgvector）
DB_PATH=data/app.db

# 切分：单块目标 token 数与相邻块重叠 token 数
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 分层记忆（Memory Governor）。MEMORY_ENABLED 是总开关，T10 的消融实验用它关掉记忆
MEMORY_ENABLED=true
# 召回条数：每轮注入 system 消息的长期记忆条数
MEMORY_RECALL_TOP_K=5
# 去重阈值：归一化（去称呼前缀/标点/空白）后整句的序列相似度，0.92 为保守值。
# 原名 MEMORY_DEDUP_THRESHOLD（T7 首次实现），复审发现它度量的是文本序列相似度而非
# brief 里说的 embedding cosine，刻度不同，故改名为 MEMORY_DEDUP_RATIO。
# 若你的 .env 里还写着旧名，请改成新名——旧名会被静默忽略并回落到默认 0.92
MEMORY_DEDUP_RATIO=0.92
# 冲突时旧记忆的置信度衰减系数
MEMORY_DECAY=0.9

# 上下文治理（Context Governor）：三个策略各自独立可开关，T10 的消融实验靠单因素
# 对照（只关一个、其余不动）验证各自贡献，不要把它们合并成一个总开关。
# 治理只改发给模型的 prompt view，数据库里的原始历史不变
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_TOOL_CLEAN_ENABLED=true
CONTEXT_TOKEN_BUDGET_ENABLED=true
# prompt view 的总预算（token，按 1 token ≈ 4 字符估算）
CONTEXT_MAX_TOKENS=8000
# 历史超过 N 条时触发压缩：保留最近 N/2 条完整对话，更早的由 LLM 生成摘要
CONTEXT_COMPACTION_THRESHOLD=10

# 可观测（T9）：traces 表埋点总开关。关掉后 LLM / 工具调用都不记（T10 的观测开销对照用），
# 已落库的历史 trace 不受影响
TRACING_ENABLED=true
# LLM 定价表：每 1M tokens 的单价（美元，与各家官方报价同一刻度），成本看板按 provider
# 选档估算（估算值，不追求与账单一致）。provider 由客户端类型与 base_url 判定：base_url
# 含 deepseek 记 deepseek 档，认不出的兼容端点（通义/Moonshot/自建）回落到 openai 档
PRICE_OPENAI_INPUT=0.15
PRICE_OPENAI_OUTPUT=0.60
PRICE_ANTHROPIC_INPUT=3.0
PRICE_ANTHROPIC_OUTPUT=15.0
PRICE_DEEPSEEK_INPUT=0.14
PRICE_DEEPSEEK_OUTPUT=0.28
